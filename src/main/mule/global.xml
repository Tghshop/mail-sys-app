    	<email:smtp-config name="email-smtp" doc:name="Email SMTP" doc:id="4a231828-ca41-4156-ab9b-0742c2a63dcd" >
		<email:smtp-connection host="${mail.host}" user="${mail.user}" password="${secure::mail.password}" port="${mail.port}">
